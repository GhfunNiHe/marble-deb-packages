#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure

override_dh_auto_install:
	dh_auto_install
	# Upstream no longer installs msm_drv_video.so; libva probes that name on MSM, so symlink it.
	set -e; found=0; \
	for d in debian/libva-v4l2/usr/lib/*/dri debian/libva-v4l2/usr/lib64/dri; do \
		[ -d "$$d" ] || continue; \
		ln -sf v4l2_drv_video.so "$$d/msm_drv_video.so"; \
		found=1; \
	done; \
	if [ "$$found" = 0 ]; then \
		echo "libva-v4l2: no dri directory under /usr/lib — dh_auto_install installed nothing" >&2; \
		exit 1; \
	fi
