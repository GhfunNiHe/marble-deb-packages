#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Build one read-only board property from this phone's stock vendor/build.prop.

The Android linker reads Bionic's pre-split format at /dev/__properties__.
Layout matches prop_area::add in android-14.0.0_r1/libc/system_properties:
https://android.googlesource.com/platform/bionic/+/refs/tags/android-14.0.0_r1/libc/system_properties/
"""

import argparse
import os
from pathlib import Path
import struct
import sys
import tempfile

PROPERTY = b"ro.product.device"
WORD = struct.Struct("<I")
NODE = struct.Struct("<5I")  # name length, property, left, right, children
VALUE_MAX = 92


def property_area(board):
    # The trie starts with a root node and Bionic's reserved value backup.
    data = bytearray(NODE.size + VALUE_MAX)
    parent = 0
    for part in PROPERTY.split(b"."):
        child = len(data)
        WORD.pack_into(data, parent + 4 * WORD.size, child)
        data.extend(NODE.pack(len(part), 0, 0, 0, 0) + part + b"\0")
        data.extend(bytes(-len(data) % WORD.size))
        parent = child
    WORD.pack_into(data, parent + WORD.size, len(data))
    data.extend(WORD.pack(len(board) << 24) + board.ljust(VALUE_MAX, b"\0") + PROPERTY + b"\0")
    data.extend(bytes(-len(data) % WORD.size))

    header = struct.pack("<4I", len(data), 0, 0x504F5250, 0xFC6ED0AB).ljust(128, b"\0")
    return (header + data).ljust(128 * 1024, b"\0")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("vendor_build_prop", type=Path)
    parser.add_argument("output", type=Path, help="new property file, install as root:root 0444")
    args = parser.parse_args()
    records = args.vendor_build_prop.read_bytes().splitlines()
    prefix = b"ro.product.vendor.device="
    boards = [line[len(prefix):] for line in records if line.startswith(prefix)]
    if boards != [b"marble"]:
        parser.error("expected exactly one ro.product.vendor.device=marble in the stock vendor build.prop")

    # Publish only a fully written file, and preserve any previous installation.
    with tempfile.NamedTemporaryFile(dir=args.output.parent) as f:
        f.write(property_area(boards[0]))
        f.flush()
        if os.geteuid() == 0:
            os.fchown(f.fileno(), 0, 0)
        os.fchmod(f.fileno(), 0o444)
        os.link(f.name, args.output)


if __name__ == "__main__":
    try:
        main()
    except OSError as exc:
        print(f"Cannot create the board property: {exc}", file=sys.stderr)
        sys.exit(1)
