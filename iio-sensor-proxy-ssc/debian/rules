#!/usr/bin/make -f

%:
	dh $@ --buildsystem=meson

# -Dssc-support=enabled is the point of this package: without it the build silently drops the SSC drivers.
#
# udevrulesdir/systemdsystemunitdir are passed explicitly so configure needs neither udev.pc nor systemd.pc.
override_dh_auto_configure:
	dh_auto_configure -- \
		-Db_lto=true \
		-Dssc-support=enabled \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		-Dudevrulesdir=/usr/lib/udev/rules.d

override_dh_auto_install:
	dh_auto_install
	install -Dm644 debian/iio-sensor-proxy.service.d/10-marble-sensors.conf \
		debian/iio-sensor-proxy-ssc/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-marble-sensors.conf
