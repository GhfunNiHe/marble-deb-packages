+const char *
+nm_config_get_os_id(void)
+{
+    static char *os_id;
+
+    if (g_once_init_enter(&os_id)) {
+        gs_free char *contents = NULL;
+        char *id = NULL;
+
+        if (g_file_get_contents("/etc/os-release", &contents, NULL, NULL)
+            || g_file_get_contents("/usr/lib/os-release", &contents, NULL, NULL))
+            nm_parse_env_file(contents, "ID", &id);
+        g_once_init_leave(&os_id, id ?: g_strdup(""));
+    }
+    return os_id;
+}
