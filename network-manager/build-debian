#!/bin/sh
set -eu

overlay=$(dirname "$(realpath "$0")")
output=$(realpath -m "${1:-out}")
arch=$(dpkg --print-architecture)
if [ "$arch" != arm64 ]; then
    echo "Build the marble NetworkManager packages in a Debian arm64 environment." >&2
    exit 1
fi

mkdir -p "$output"
work=$(mktemp -d "$output/.network-manager.XXXXXXXX")
trap 'rm -rf "$work"' EXIT
cd "$work"

snapshot=https://snapshot.debian.org/archive/debian/20260905T000000Z
while read -r digest archive; do
    /usr/lib/apt/apt-helper download-file \
        "$snapshot/pool/main/n/network-manager/$archive" "$archive" "SHA256:$digest"
done < "$overlay/SHA256SUMS"

dpkg-source -x network-manager_*.dsc src
cd src
base_version=$(dpkg-parsechangelog -S Version)
cp "$overlay"/debian/patches/*.patch debian/patches/
cat "$overlay/debian/patches/series" >> debian/patches/series
{
    cat "$overlay/debian/changelog"
    printf '\n'
    cat debian/changelog
} > debian/changelog.marble
mv debian/changelog.marble debian/changelog
version=$(dpkg-parsechangelog -S Version)
dpkg-checkbuilddeps -B || apt-get build-dep -y --no-install-recommends .
dpkg-buildpackage -B -us -uc

cd "$work"
bundle="network-manager-debian_${base_version}_${arch}.tar"
tar -cf "$bundle" \
    "network-manager_${version}_${arch}.deb" \
    "libnm0_${version}_${arch}.deb" \
    "network-manager-tui_${version}_${arch}.deb"
mv "$bundle" "$output/"
