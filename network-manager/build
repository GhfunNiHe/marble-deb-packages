#!/bin/sh
set -eu

overlay=$(dirname "$(realpath "$0")")
output=$(realpath -m "${1:-out}")
cache=$(realpath -m "${RUNNER_TEMP:-$PWD}/build/network-manager")
package_version=$(dpkg-parsechangelog -l "$overlay/debian/changelog" -S Version)
ubuntu_version=${package_version%+marble*}
ubuntu=https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/network-manager/$ubuntu_version
snapshot=https://snapshot.debian.org/archive/debian/20261119T000000Z/pool/main

mkdir -p "$output" "$cache"
cd "$cache"
work=$(mktemp -d "$cache/build.XXXXXXXX")
trap 'rm -rf "$work"' EXIT

fetch() {
    if ! printf '%s  %s\n' "$3" "$2" | sha256sum --check --status 2>/dev/null; then
        /usr/lib/apt/apt-helper download-file "$1" "$2" "SHA256:$3"
    fi
}

while read -r digest archive; do
    case "$archive" in
        network-manager_*.dsc)
            url=${NETWORKMANAGER_SRC_DSC:-$ubuntu/$archive}
            srcdir=$cache
            if [ -n "${NETWORKMANAGER_SRC_DSC:-}" ]; then
                srcdir=$work
            fi
            dsc=$srcdir/${url##*/}
            fetch "$url" "$dsc" "${NETWORKMANAGER_SRC_SHA256:-$digest}"
            awk '/^Checksums-Sha256:/ { files=1; next } !/^ / { files=0 } files { print $1, $3 }' "$dsc" |
            while read -r sha file; do
                case "$file" in
                    ""|.*|*/*) echo "Invalid source archive name: $file" >&2; exit 1 ;;
                esac
                fetch "${url%/*}/$file" "$srcdir/$file" "$sha"
            done
            continue ;;
        libndp_*) pool=$snapshot/libn/libndp ;;
        ppp-dev_*) pool=$snapshot/p/ppp ;;
    esac
    fetch "$pool/$archive" "$archive" "$digest"
done < "$overlay/SHA256SUMS"

cd "$work"
dpkg-source -x "$dsc" src
cd src
if [ "$(dpkg-parsechangelog -S Source)" != network-manager ]; then
    echo "Expected a network-manager source package" >&2
    exit 1
fi
source_version=$(dpkg-parsechangelog -S Version)
patch -p1 < "$overlay/packaging-noble.patch"
cp "$overlay"/debian/patches/*.patch debian/patches/
cat "$overlay/debian/patches/series" >> debian/patches/series
{
    sed "1s/([^)]*)/(${source_version}+${package_version##*+})/" "$overlay/debian/changelog"
    printf '\n'
    cat debian/changelog
} > debian/changelog.marble
mv debian/changelog.marble debian/changelog
mkdir -p debian/ppp-headers
for archive in "$cache"/ppp-dev_*.deb; do
    version=$(dpkg-deb -f "$archive" Version)
    dpkg-deb -x "$archive" "debian/ppp-headers/${version%%-*}"
done
dpkg-checkbuilddeps || apt-get build-dep -y --no-install-recommends .

# CLAT uses the PREF64 router advertisement API added in libndp 1.9.
# Build the static library with the same compiler and libc as NetworkManager.
mkdir "$work/libndp"
tar -xf "$cache"/libndp_*.orig.tar.gz -C "$work/libndp" --strip-components=1
(
    cd "$work/libndp"
    autoreconf -fi
    ./configure --prefix="$work/ndp" --disable-shared --enable-static --with-pic
    make
    make install
)
export PKG_CONFIG_PATH="$work/ndp/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
# Ubuntu's /usr/sbin/bpftool wrapper expects the running kernel's tools.
# Use the executable provided by the Noble build dependency in containers.
tools_pkg=$(dpkg-query -W -f='${Depends}' linux-tools-generic)
bpftool=$(dpkg-query -L "$tools_pkg" | grep '/bpftool$')
export PATH="$(dirname "$bpftool"):$PATH"
dpkg-buildpackage -b -us -uc

version=$(dpkg-parsechangelog -S Version)
arch=$(dpkg --print-architecture)
for name in network-manager libnm0 libnm-dev gir1.2-nm-1.0 network-manager-tui network-manager-ovs network-manager-team; do
    cp "$work/${name}_${version}_${arch}.deb" "$output/"
done
cp "$work/network-manager-l10n_${version}_all.deb" "$output/"
