#!/bin/sh
# postinst for linux-xiaomi-marble (no-initramfs direct-boot route, same as
# the original project's verified path: alt.conf has no initrd line):
#   1. verify that /boot/efi is vfat and identifies as ESP by either
#      PARTLABEL=esp or filesystem LABEL=ESP. The latter also covers the
#      partitionless rootfs loop image, which cannot have a PARTLABEL.
#   2. fail an upgrade if its boot entry is missing
#   3. depmod for the new kernel (modules live in /usr/lib/modules/<ver>,
#      loaded by udev/systemd after the rootfs mounts)
#   4. ESP sync: uncompressed Image -> /marble/vmlinuz and DTB -> /marble/...
#   5. Only an initial installation creates /extlinux/extlinux.conf; upgrades
#      leave the existing boot entry untouched.
#   A missing, unmounted or unexpected ESP is a configuration error: fail with
#   a recovery hint instead of writing boot files to the wrong filesystem.
set -e

# Kernel release: authoritative source is the installed marker file,
# falling back to the newest modules directory.
KREL=$(cat /usr/share/linux-xiaomi-marble/kernel.release 2>/dev/null || true)
if [ -z "$KREL" ]; then
	KREL=$(ls -dt /usr/lib/modules/*/ 2>/dev/null | head -1 | sed 's#/$##; s#.*/##')
fi

case "$1" in
	configure)
		if [ -z "$KREL" ]; then
			echo "linux-xiaomi-marble: no kernel modules found, skipping" >&2
			exit 0
		fi

		# 1. The boot chain cannot be updated without the expected ESP.
		if [ ! -d /boot/efi ]; then
			echo "linux-xiaomi-marble: ERROR: ESP mount point /boot/efi was not found." >&2
			echo "  Ensure the ESP exists and is configured in /etc/fstab, mount it at /boot/efi," >&2
			echo "  then run: dpkg --configure -a" >&2
			exit 1
		fi
		if ! mountpoint -q /boot/efi; then
			echo "linux-xiaomi-marble: ERROR: ESP is not mounted at /boot/efi." >&2
			echo "  Mount the ESP at /boot/efi, then run: dpkg --configure -a" >&2
			exit 1
		fi

		ESP_FSTYPE=$(findmnt -n -o FSTYPE --target /boot/efi 2>/dev/null || true)
		if [ "$ESP_FSTYPE" != vfat ]; then
			echo "linux-xiaomi-marble: ERROR: /boot/efi is not a vfat ESP (found: ${ESP_FSTYPE:-unknown})." >&2
			echo "  Refusing to write boot files. Unmount it and mount the marble ESP" >&2
			echo "  (PARTLABEL=esp or LABEL=ESP) at /boot/efi, then run:" >&2
			echo "  dpkg --configure -a" >&2
			exit 1
		fi

		ESP_PARTLABEL=$(findmnt -n -o PARTLABEL --target /boot/efi 2>/dev/null || true)
		ESP_LABEL=$(findmnt -n -o LABEL --target /boot/efi 2>/dev/null || true)
		if [ "$ESP_PARTLABEL" != esp ] &&
		   [ "$ESP_LABEL" != ESP ] && [ "$ESP_LABEL" != esp ]; then
			echo "linux-xiaomi-marble: ERROR: /boot/efi is vfat but has PARTLABEL='${ESP_PARTLABEL:-<empty>}' and LABEL='${ESP_LABEL:-<empty>}'." >&2
			echo "  Expected PARTLABEL=esp or filesystem LABEL=ESP." >&2
			echo "  Unmount it and mount the marble ESP at /boot/efi, then run:" >&2
			echo "  dpkg --configure -a" >&2
			exit 1
		fi

		# 2. Never replace a working kernel/DTB if the upgrade has no boot
		#    entry to reach them. Recovery must happen before configuration.
		if [ -n "$2" ] && [ ! -f /boot/efi/extlinux/extlinux.conf ]; then
			echo "linux-xiaomi-marble: ERROR: upgrade found no /boot/efi/extlinux/extlinux.conf." >&2
			echo "  The kernel and DTB were not replaced. Restore the existing boot entry" >&2
			echo "  on the ESP, then run: dpkg --configure -a" >&2
			exit 1
		fi

		# 3. module dependency database (ext4/UFS are built-in, so the
		#    kernel mounts root directly; extra drivers load from rootfs)
		depmod -a "$KREL"

		# 4. Sync the kernel and DTB on both installation and upgrade.
		mkdir -p /boot/efi/marble
		# /boot/vmlinuz-<ver> IS the uncompressed arm64 Image (U-Boot
		# booti requirement), just renamed on the ESP like the original
		# project's manual step.
		cp /boot/vmlinuz-"$KREL" /boot/efi/marble/vmlinuz
		cp /boot/sm8475-xiaomi-marble-"$KREL".dtb /boot/efi/marble/sm8475-xiaomi-marble.dtb

		if [ -z "$2" ]; then
			# Initial installation only. $2 is the previously configured
			# version on upgrades, so never overwrite an existing boot entry
			# after the user may have edited it.
			mkdir -p /boot/efi/extlinux

			# root= is NOT hardcoded. The source of truth is the "/" entry of
			# /etc/fstab, which is where the rootfs build (and the user) decides
			# which partition to boot from; PARTLABEL=/UUID=/LABEL=/dev/... are
			# all valid kernel root= values, so the fstab source field is passed
			# through verbatim. Falls back to whatever the ESP already carries,
			# then to the established default.
			ROOT_SPEC=$(awk '!/^#/ && $2 == "/" { print $1; exit }' /etc/fstab 2>/dev/null || true)
			if [ -z "$ROOT_SPEC" ] && [ -f /boot/efi/extlinux/extlinux.conf ]; then
				ROOT_SPEC=$(sed -n 's/.*[[:space:]]root=\([^ ]*\).*/\1/p' \
					/boot/efi/extlinux/extlinux.conf | head -1)
			fi
			if [ -z "$ROOT_SPEC" ]; then
				ROOT_SPEC="PARTLABEL=linux"
				echo "linux-xiaomi-marble: no root entry in /etc/fstab, falling back to root=$ROOT_SPEC" >&2
			fi

			# extlinux.conf: cmdline is version-independent; U-Boot's default
			# bootcmd reads /extlinux/extlinux.conf.
			cat > /boot/efi/extlinux/extlinux.conf <<EOF
timeout 3
default marble

label marble
	menu label Debian (marble)
	kernel /marble/vmlinuz
	fdt /marble/sm8475-xiaomi-marble.dtb
	append root=$ROOT_SPEC rootwait rw console=tty0 loglevel=4 printk.devkmsg=on pstore.compress=none log_buf_len=2M msm_geni_serial.con_enabled=0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fw_devlink=permissive pcie_aspm=off
EOF
			echo "linux-xiaomi-marble: ESP synced (vmlinuz + dtb) and extlinux.conf created for $KREL, root=$ROOT_SPEC"
		else
			echo "linux-xiaomi-marble: ESP synced (vmlinuz + dtb) for $KREL; existing extlinux.conf left unchanged"
		fi
		;;
esac

exit 0
