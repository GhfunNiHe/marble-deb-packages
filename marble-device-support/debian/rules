#!/usr/bin/make -f

%:
	dh $@

# Fedora build host: no strip-nondeterminism, nothing to normalise.
override_dh_strip_nondeterminism:

# dpkg-shlibdeps unavailable on Fedora; Depends live in debian/control.
override_dh_shlibdeps:

# Runtime sources and installation rules are owned by the support-layer fork.
override_dh_auto_build:
	dh_auto_build -- WITH_IMS=1

override_dh_auto_install:
	$(MAKE) WITH_IMS=1 PREFIX=/usr DESTDIR=debian/marble-device-support install-debian

# dh_fixperms normalises mode 0600; NetworkManager rejects readable keyfiles.
override_dh_fixperms:
	dh_fixperms
	chmod 600 debian/marble-device-support/usr/lib/NetworkManager/system-connections/ct-data.nmconnection
