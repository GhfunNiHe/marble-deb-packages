[Unit]
Description=marble: re-arm the SSC sensor chain after an SLPI restart
Documentation=file:///usr/share/doc/marble-device-support/README.md

[Service]
# Triggered by udev when /dev/fastrpc-sdsp (re)appears, i.e. at boot and after
# every SLPI remoteproc recovery. From the outside a stale session looks
# exactly like a healthy one (unit active, no restarts), so the device event
# is the only reliable moment to re-arm the chain. try-restart is deliberate:
# it does nothing when hexagonrpcd is not up yet, which is the common case for
# the udev event at boot.
Type=oneshot
ExecStart=/bin/systemctl --no-block try-restart hexagonrpcd.service
TimeoutStartSec=30
