[Unit]
Description=marble: restore the factory WLAN and Bluetooth MACs from persist
# WLAN: stage wlan_mac.bin before ath11k_pci loads (blacklisted), hence the
# explicit modprobe. BT: the QCA NV has no BD_ADDR, so push it after bluetoothd
# powers hci0. Order after the persist udev device or WLAN never comes up.
Wants=dev-disk-by\x2dpartlabel-persist.device
After=dev-disk-by\x2dpartlabel-persist.device
After=local-fs.target bluetooth.service
Before=network.target NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/marble-helper mac-restore
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
