+#define SSC_SERVICE_TIMEOUT_MS 30000
+
+typedef struct {
+	GTask *task;
+	QrtrBus *bus;
+	GPtrArray *nodes;
+	GSource *timeout;
+} SSCServiceWait;
+
+static void
+finish_service_wait (SSCServiceWait *wait, QrtrNode *node)
+{
+	GTask *task = wait->task;
+
+	g_signal_handlers_disconnect_by_data (wait->bus, wait);
+	for (guint i = 0; i < wait->nodes->len; i++)
+		g_signal_handlers_disconnect_by_data (g_ptr_array_index (wait->nodes, i), wait);
+	g_ptr_array_unref (wait->nodes);
+	g_source_destroy (wait->timeout);
+	g_source_unref (wait->timeout);
+	g_free (wait);
+
+	if (!g_task_return_error_if_cancelled (task)) {
+		if (node) {
+			qmi_device_new_from_node (node, g_task_get_cancellable (task),
+						  device_new_ready, task);
+			return;
+		}
+		g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_TIMED_OUT,
+					 "Timed out waiting for the QRTR SSC service");
+	}
+	g_object_unref (task);
+}
+
+static gboolean
+service_wait_expired (gpointer user_data)
+{
+	finish_service_wait (user_data, NULL);
+	return G_SOURCE_REMOVE;
+}
+
+static void
+service_added (QrtrNode *node, guint service, SSCServiceWait *wait)
+{
+	if (service == QMI_SERVICE_SSC)
+		finish_service_wait (wait, node);
+}
+
+static gboolean
+watch_node (SSCServiceWait *wait, QrtrNode *node)
+{
+	if (qrtr_node_lookup_port (node, QMI_SERVICE_SSC) >= 0) {
+		finish_service_wait (wait, node);
+		return TRUE;
+	}
+
+	g_ptr_array_add (wait->nodes, g_object_ref (node));
+	g_signal_connect (node, QRTR_NODE_SIGNAL_SERVICE_ADDED, G_CALLBACK (service_added), wait);
+	return FALSE;
+}
+
+static void
+node_added (QrtrBus *bus, guint node_id, SSCServiceWait *wait)
+{
+	watch_node (wait, qrtr_bus_peek_node (bus, node_id));
+}
