+	/* Find QRTR node for SSC service.
+	 *
+	 * The SSC service appears on the QRTR bus only once the DSP side is up:
+	 * hexagonrpcd publishes it a few seconds into the boot, and on a
+	 * direct-boot (no initramfs) system iio-sensor-proxy can be started before
+	 * that happens. Retry for a few seconds instead of failing on the first
+	 * lookup, so the sensor proxy does not have to be restarted by hand.
+	 * (CI asserts on the message below, so a patch that stops applying is
+	 * caught instead of silently building an unchanged library.) */
+	for (int attempt = 0; attempt < 5; attempt++) {
+		for (GList *l = qrtr_bus_peek_nodes (priv->bus); l != NULL; l = l->next) {
+			node = l->data;
+
+			if (node && qrtr_node_lookup_port (node, QMI_SERVICE_SSC) >= 0) {
+				found = TRUE;
+				break;
+			}
+		}
 
-		if (node && qrtr_node_lookup_port (node, QMI_SERVICE_SSC) >= 0) {
-			found = TRUE;
+		if (found || attempt == 4)
 			break;
-		}
+
+		g_debug ("SSC service not found yet, retrying (%d/5)", attempt + 1);
+		sleep (1);
 	}
 
