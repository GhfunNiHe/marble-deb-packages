+static gboolean is_voice_profile(const pa_card_profile_info2 *profile)
+{
+    return profile && (g_str_equal(profile->name, SND_USE_CASE_VERB_VOICECALL) ||
+                       g_str_has_prefix(profile->name, SND_USE_CASE_VERB_VOICECALL " ("));
+}
+
+static gboolean port_has_profile(const pa_card_port_info *port,
+                                 const pa_card_profile_info2 *profile)
+{
+    for (guint i = 0; port->profiles2 && i < port->n_profiles; i++)
+        if (g_str_equal(port->profiles2[i]->name, profile->name))
+            return TRUE;
+
+    return FALSE;
+}
+
+/* Only infer a route when every available output in this profile agrees. */
+static CallAudioSpeakerState voice_profile_speaker(const pa_card_info *card,
+                                                   const pa_card_profile_info2 *profile)
+{
+    CallAudioSpeakerState state = CALL_AUDIO_SPEAKER_UNKNOWN;
+
+    for (guint i = 0; i < card->n_ports; i++) {
+        const pa_card_port_info *port = card->ports[i];
+        CallAudioSpeakerState next;
+
+        if (port->direction != PA_DIRECTION_OUTPUT || port->available == PA_PORT_AVAILABLE_NO ||
+            !port_has_profile(port, profile))
+            continue;
+        switch (port->type) {
+        case PA_DEVICE_PORT_TYPE_SPEAKER:
+            next = CALL_AUDIO_SPEAKER_ON;
+            break;
+        case PA_DEVICE_PORT_TYPE_EARPIECE:
+        case PA_DEVICE_PORT_TYPE_HANDSET:
+        case PA_DEVICE_PORT_TYPE_HEADPHONES:
+        case PA_DEVICE_PORT_TYPE_HEADSET:
+            next = CALL_AUDIO_SPEAKER_OFF;
+            break;
+        default:
+            return CALL_AUDIO_SPEAKER_UNKNOWN;
+        }
+        if (state != CALL_AUDIO_SPEAKER_UNKNOWN && state != next)
+            return CALL_AUDIO_SPEAKER_UNKNOWN;
+        state = next;
+    }
+    return state;
+}
+
+static gboolean has_same_inputs(const pa_card_info *card,
+                                const pa_card_profile_info2 *a,
+                                const pa_card_profile_info2 *b)
+{
+    if (a->n_sources != b->n_sources)
+        return FALSE;
+    for (guint i = 0; i < card->n_ports; i++) {
+        const pa_card_port_info *port = card->ports[i];
+        if (port->direction == PA_DIRECTION_INPUT &&
+            port_has_profile(port, a) != port_has_profile(port, b))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static void update_voice_profile(pa_context *ctx, const pa_card_info *card, int eol, void *data)
+{
+    CadPulse *self = data;
+    CallAudioMode mode;
+    CallAudioSpeakerState speaker;
+
+    if (eol || !card || card->index != self->card_id || !self->has_voice_profile)
+        return;
+
+    mode = is_voice_profile(card->active_profile2) ? CALL_AUDIO_MODE_CALL : CALL_AUDIO_MODE_DEFAULT;
+    speaker = CALL_AUDIO_SPEAKER_UNKNOWN;
+    if (mode == CALL_AUDIO_MODE_CALL)
+        speaker = voice_profile_speaker(card, card->active_profile2);
+    else if (self->audio_mode == CALL_AUDIO_MODE_CALL)
+        speaker = CALL_AUDIO_SPEAKER_OFF;
+    if (mode != self->audio_mode) {
+        self->audio_mode = mode;
+        g_object_set(self->manager, "audio-mode", mode, NULL);
+    }
+    if (speaker != CALL_AUDIO_SPEAKER_UNKNOWN && speaker != self->speaker_state) {
+        self->speaker_state = speaker;
+        g_object_set(self->manager, "speaker-state", speaker, NULL);
+    }
+}
