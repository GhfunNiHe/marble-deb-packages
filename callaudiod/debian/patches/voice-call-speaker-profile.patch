+static void set_speaker_profile(pa_context *ctx, const pa_card_info *card, int eol, void *data)
+{
+    CadPulseOperation *operation = data;
+    const pa_card_profile_info2 *best = NULL;
+    pa_operation *op = NULL;
+
+    /* By-index introspection also sends an end marker after the data callback. */
+    if (eol > 0)
+        return;
+    if (eol < 0 || !card || card->index != operation->pulse->card_id ||
+        operation->speaker_request != operation->pulse->speaker_request ||
+        !is_voice_profile(card->active_profile2))
+        goto done;
+
+    for (guint i = 0; i < card->n_profiles; i++) {
+        const pa_card_profile_info2 *profile = card->profiles2[i];
+        if (!profile->available || !is_voice_profile(profile) ||
+            profile == card->active_profile2 ||
+            voice_profile_speaker(card, profile) != (operation->value ? CALL_AUDIO_SPEAKER_ON
+                                                                      : CALL_AUDIO_SPEAKER_OFF) ||
+            !has_same_inputs(card, card->active_profile2, profile))
+            continue;
+        if (!best || profile->priority > best->priority)
+            best = profile;
+    }
+    if (best)
+        op = pa_context_set_card_profile_by_index(ctx, card->index, best->name,
+                                                  operation_complete_cb, operation);
+done:
+    if (op)
+        pa_operation_unref(op);
+    else
+        operation_complete_cb(ctx, 0, operation);
+}
