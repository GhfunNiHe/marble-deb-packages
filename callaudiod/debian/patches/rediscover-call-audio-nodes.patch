+static void set_mic_on_source(pa_context *ctx, const pa_source_info *info, int eol, void *data)
+{
+    CadPulseOperation *operation = data;
+    CadPulse *self;
+    pa_operation *op;
+
+    if (eol > 0)
+        return;
+    self = operation->pulse;
+    if (operation->request != self->requests[CAD_OPERATION_MUTE_MIC]) {
+        operation_complete_cb(ctx, 0, operation);
+        return;
+    }
+    if (eol < 0 || !info || info->card != self->card_id ||
+        info->index != self->source_id || info->monitor_of_sink != PA_INVALID_INDEX) {
+        if (self->source_id == operation->endpoint_id)
+            forget_source(self);
+        wait_for_endpoint(operation);
+        return;
+    }
+    if (!!info->mute == !!operation->value) {
+        operation_complete_cb(ctx, 1, operation);
+        return;
+    }
+    op = pa_context_set_source_mute_by_index(ctx, info->index, operation->value,
+                                             operation_complete_cb, operation);
+    if (op)
+        pa_operation_unref(op);
+    else
+        operation_complete_cb(ctx, 0, operation);
+}
+
+static gboolean issue_endpoint_operation(gpointer data)
+{
+    CadPulseOperation *operation = data;
+    CadPulse *self = operation->pulse;
+    CadOperationType type = operation->op->type;
+    pa_operation *op;
+
+    if (operation->request != self->requests[type]) {
+        operation_complete_cb(self->ctx, 0, operation);
+        return G_SOURCE_REMOVE;
+    }
+    if (!self->ctx || pa_context_get_state(self->ctx) != PA_CONTEXT_READY ||
+        self->card_id == PA_INVALID_INDEX) {
+        wait_for_endpoint(operation);
+        return G_SOURCE_REMOVE;
+    }
+    if (type == CAD_OPERATION_SELECT_MODE && self->has_voice_profile) {
+        op = pa_context_get_card_info_by_index(self->ctx, self->card_id,
+                                               set_card_profile, operation);
+        if (op)
+            pa_operation_unref(op);
+        else
+            operation_complete_cb(self->ctx, 0, operation);
+        return G_SOURCE_REMOVE;
+    }
+    if (self->selecting_mode && operation->op->callback && type != CAD_OPERATION_SELECT_MODE) {
+        wait_for_endpoint(operation);
+        return G_SOURCE_REMOVE;
+    }
+    if (type == CAD_OPERATION_ENABLE_SPEAKER && operation->op->callback &&
+        self->has_voice_profile && !operation->profile_checked) {
+        op = pa_context_get_card_info_by_index(self->ctx, self->card_id,
+                                               set_speaker_profile, operation);
+        if (op)
+            pa_operation_unref(op);
+        else
+            operation_complete_cb(self->ctx, 0, operation);
+        return G_SOURCE_REMOVE;
+    }
+    operation->endpoint_id = type == CAD_OPERATION_MUTE_MIC ? self->source_id : self->sink_id;
+    if (operation->endpoint_id == PA_INVALID_INDEX) {
+        wait_for_endpoint(operation);
+        return G_SOURCE_REMOVE;
+    }
+
+    if (type == CAD_OPERATION_MUTE_MIC)
+        op = pa_context_get_source_info_by_index(self->ctx, operation->endpoint_id,
+                                                 set_mic_on_source, operation);
+    else
+        op = pa_context_get_sink_info_by_index(self->ctx, operation->endpoint_id,
+                                               set_output_port, operation);
+    if (op)
+        pa_operation_unref(op);
+    else
+        operation_complete_cb(self->ctx, 0, operation);
+
+    return G_SOURCE_REMOVE;
+}
+
+static CadPulseOperation *new_operation(CadOperation *cad_op, guint value)
+{
+    CadPulse *self = cad_pulse_get_default();
+    CadPulseOperation *operation = g_new0(CadPulseOperation, 1);
+
+    operation->pulse = self;
+    operation->op = cad_op;
+    operation->value = value;
+    operation->request = ++self->requests[cad_op->type];
+    /* D-Bus activation and UCM profile switches can precede node publication. */
+    operation->deadline = g_get_monotonic_time() + 3 * G_TIME_SPAN_SECOND;
+    return operation;
+}
