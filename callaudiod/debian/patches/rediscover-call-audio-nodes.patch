+static void forget_sink(CadPulse *self)
+{
+    self->sink_id = PA_INVALID_INDEX;
+    g_clear_pointer(&self->sink_ports, g_hash_table_destroy);
+    g_clear_pointer(&self->speaker_port, g_free);
+    g_clear_pointer(&self->earpiece_port, g_free);
+}
+
+static void forget_source(CadPulse *self)
+{
+    self->source_id = PA_INVALID_INDEX;
+    g_clear_pointer(&self->source_ports, g_hash_table_destroy);
+}
+
+static void forget_card(CadPulse *self)
+{
+    forget_sink(self);
+    forget_source(self);
+    self->card_id = PA_INVALID_INDEX;
+    self->has_voice_profile = FALSE;
+    self->selecting_mode = FALSE;
+    for (guint i = 0; i < G_N_ELEMENTS(self->requests); i++)
+        self->requests[i]++;
+    self->audio_mode = CALL_AUDIO_MODE_UNKNOWN;
+    self->speaker_state = CALL_AUDIO_SPEAKER_UNKNOWN;
+    self->mic_state = CALL_AUDIO_MIC_UNKNOWN;
+    g_object_set(self->manager, "audio-mode", self->audio_mode,
+                 "speaker-state", self->speaker_state, "mic-state", self->mic_state, NULL);
+}
+
+/* A new node can be published before the old node's removal notification. */
+static void find_endpoints(CadPulse *self)
+{
+    pa_operation *op;
+
+    if (self->card_id == PA_INVALID_INDEX)
