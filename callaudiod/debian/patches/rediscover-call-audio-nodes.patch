+static void wait_for_endpoint(CadPulseOperation *operation)
+{
+    CadPulse *self = operation->pulse;
+
+    if (operation->request == self->requests[operation->op->type] &&
+        g_get_monotonic_time() < operation->deadline) {
+        if (self->ctx && pa_context_get_state(self->ctx) == PA_CONTEXT_READY)
+            find_endpoints(self);
+        g_timeout_add(40, issue_endpoint_operation, operation);
+    } else {
+        operation_complete_cb(self->ctx, 0, operation);
+    }
+}
