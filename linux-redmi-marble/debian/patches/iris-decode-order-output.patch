From: GhfunNiHe <131235947+GhfunNiHe@users.noreply.github.com>
Subject: media: iris: support decode-order output on HFI gen2
 Clients that decode synchronously - one picture in, one picture out, such
 as the VA-API backend (v4l2_drv_video.so from radxa-pkg/libva-v4l2) - wait
 for a decoded picture before submitting more bitstream. The gen2 firmware
 returns pictures in display order by default, so it may withhold that
 picture until further input arrives and such clients never make progress:
 the backend aborts in its decoder constructor with
 "S_CTRL DISPLAY_DELAY (Iris decode-order patch required): Invalid argument"
 and applications silently fall back to software decoding.
 .
 Expose the standard decoder display-delay controls through the HFI gen2
 decoder capability table, accept only a zero display delay (which maps to
 decode-order output) and leave the feature disabled by default. The value
 is forwarded as HFI_PROP_DECODE_ORDER_OUTPUT on the decoder input
 configuration path before OUTPUT starts, so a client that never touches
 the controls keeps the firmware default untouched.
 .
 marble (SM7475) lands on this table even though its VPU is a "vpu2":
 sm8450_data.firmware_desc is iris_vpu20_4v_gen2_desc, so the firmware data
 is iris_hfi_gen2_vpu2_data and the decoder caps come from
 inst_fw_cap_sm8550_dec[]. The gen1 tables are dead code on this device.
 .
 Same change as radxa-pkg/libva-v4l2's kernel patch for SC8280XP
 (Xilin Wu <sophon@radxa.com>), regenerated against this tree.
Forwarded: no
---
diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.c b/drivers/media/platform/qcom/iris/iris_ctrls.c
index 6fa6dd6e9..ecd3b41e0 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -156,6 +156,10 @@ static enum platform_inst_fw_cap_type iris_get_cap_id(u32 id)
 		return LAYER4_BITRATE_HEVC;
 	case V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L5_BR:
 		return LAYER5_BITRATE_HEVC;
+	case V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE:
+		return DISPLAY_DELAY_ENABLE;
+	case V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY:
+		return DISPLAY_DELAY;
 	default:
 		return INST_FW_CAP_MAX;
 	}
@@ -301,6 +305,10 @@ static u32 iris_get_v4l2_id(enum platform_inst_fw_cap_type cap_id)
 		return V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L4_BR;
 	case LAYER5_BITRATE_HEVC:
 		return V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L5_BR;
+	case DISPLAY_DELAY_ENABLE:
+		return V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE;
+	case DISPLAY_DELAY:
+		return V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY;
 	default:
 		return 0;
 	}
