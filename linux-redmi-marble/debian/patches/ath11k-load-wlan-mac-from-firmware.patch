From: GhfunNiHe <131235947+GhfunNiHe@users.noreply.github.com>
Subject: wifi: ath11k: load the factory WLAN MAC from wlan_mac.bin
 The WiFi chip on marble sits on PCIe: the device tree carries no
 local-mac-address for it and the mainline firmware blobs (amss.bin,
 board.bin) carry none either, so ar->mac_addr stays all-zero,
 SET_IEEE80211_PERM_ADDR() registers a zero permanent address and mac80211
 hands every interface a fresh random address at each boot
 (addr_assign_type=NET_ADDR_RANDOM). NetworkManager's default
 "restore the permanent address" then fails with EADDRNOTAVAIL, which is
 what made connection activation abort with 'config-failed'.
 .
 Mirror of the ath12k fix in ianchb/sm8550-mainline@42f3b40 adapted to
 ath11k: when neither the DT nor the firmware provided a MAC, read
 "wlan_mac.bin" ("wlan0=<12 hex digits>", as saved by Android on the
 persist partition) through ath11k_core_firmware_request(), i.e. from
 /lib/firmware/ath11k/WCN6855/hw2.1/ on this board. marble-device-support
 ships marble-wlan-mac.service, which copies the file out of the persist
 partition and loads ath11k_pci afterwards (the module is blacklisted so
 it cannot autoload earlier).
Forwarded: no
---
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -8,6 +8,7 @@
 #include <net/cfg80211.h>
 #include <linux/etherdevice.h>
 #include <linux/bitfield.h>
+#include <linux/hex.h>
 #include <linux/inetdevice.h>
 #include <net/if_inet6.h>
 #include <net/ipv6.h>
@@ -10701,6 +10702,44 @@
 	return ret;
 }
 
+static int ath11k_mac_read_wlan_mac(struct ath11k_base *ab, u8 *mac_addr)
+{
+	const struct firmware *fw;
+	char buf[6 + 2 * ETH_ALEN];
+	int ret;
+
+	fw = ath11k_core_firmware_request(ab, "wlan_mac.bin");
+	if (IS_ERR(fw))
+		return PTR_ERR(fw);
+
+	if (fw->size != sizeof(buf)) {
+		ath11k_warn(ab, "invalid size of wlan_mac.bin: %zu\n", fw->size);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	memcpy(buf, fw->data, sizeof(buf));
+
+	if (strncmp(buf, "wlan0=", 6)) {
+		ath11k_warn(ab, "invalid prefix in wlan_mac.bin\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = hex2bin(mac_addr, buf + 6, ETH_ALEN);
+	if (ret)
+		goto out;
+
+	if (!is_valid_ether_addr(mac_addr)) {
+		ath11k_warn(ab, "invalid MAC address in wlan_mac.bin\n");
+		ret = -EINVAL;
+	}
+
+out:
+	release_firmware(fw);
+	return ret;
+}
+
 int ath11k_mac_register(struct ath11k_base *ab)
 {
 	struct ath11k *ar;
@@ -10722,6 +10761,17 @@
 
 	device_get_mac_address(ab->dev, mac_addr);
 
+	/* The WiFi chip sits on PCIe: neither the device tree nor the mainline
+	 * firmware blobs carry a MAC address for it, so mac_addr stays all-zero
+	 * and mac80211 hands every interface a random address (and NM's
+	 * "restore the permanent address" step then fails EADDRNOTAVAIL against
+	 * the zero perm_addr). Fall back to the factory MAC saved on the
+	 * persist partition, which marble-wlan-mac.service places in the
+	 * firmware directory before this driver is loaded.
+	 */
+	if (is_zero_ether_addr(mac_addr) && is_zero_ether_addr(ab->mac_addr))
+		ath11k_mac_read_wlan_mac(ab, mac_addr);
+
 	for (i = 0; i < ab->num_radios; i++) {
 		pdev = &ab->pdevs[i];
 		ar = pdev->ar;
