#!/usr/bin/make -f

KERNEL_VER = 7.2.8
KERNEL_ARCH = arm64
SOC = sm8475
PKG = linux-redmi-marble
# Reference config with our deviations merged in; laid next to debian/ in the
# upstream tree by the CI workflow before dpkg-buildpackage runs.
KERNEL_CONFIG = config-xiaomi-marble.aarch64
DTB_NAME = sm8475-xiaomi-marble

export DH_VERBOSE = 1

%:
	dh $@

# debian/source/format is 3.0 (native), so dpkg-source does not apply
# debian/patches/series for us. Apply it here instead of in the workflow:
# the patch set stays part of the package, a local dpkg-buildpackage run
# behaves like CI, and a patch that stops applying fails the build loudly
# instead of silently shipping an unpatched kernel.
#
# The kernel has no configure step; config sync happens in the build rule
# (LOCALVERSION depends on the upstream HEAD commit resolved at build time).
override_dh_auto_configure:
	@set -e; \
	sed -e 's/#.*//' -e '/^[[:space:]]*$$/d' debian/patches/series | \
	while read -r p; do \
		if patch -p1 --dry-run --silent < debian/patches/$$p >/dev/null 2>&1; then \
			echo "applying debian/patches/$$p"; \
			patch -p1 --silent < debian/patches/$$p; \
		elif patch -p1 -R --dry-run --silent < debian/patches/$$p >/dev/null 2>&1; then \
			echo "debian/patches/$$p already applied"; \
		else \
			echo "FAIL: debian/patches/$$p does not apply" >&2; exit 1; \
		fi; \
	done

# dh_auto_clean would run 'make distclean', and upstream's MRPROPER_FILES
# lists the top-level debian/ directory (make deb-pkg creates it there, so
# mrproper deletes it) - which is exactly where this packaging lives. The
# tree arrives as a fresh tarball anyway, so there is nothing to clean.
override_dh_auto_clean:

# The kernel tree has a `test` target that dh_auto_test finds and runs, and it
# is not a test suite: it is `make syncconfig`, which re-runs kconfig's
# scripts/kconfig/conf on the real .config. Interactively that process blocks
# forever reading /dev/pts (its stdin), and the whole build hangs after Image
# is already built; with stdin at /dev/null it returns immediately but has
# still touched .config behind the build's back. There is nothing to test in a
# kernel package, so skip it outright.
override_dh_auto_test:

override_dh_auto_build:
	# Resolve a short hash for a traceable LOCALVERSION (same scheme as the
	# sheng RPM spec), in order of trust:
	#   1. KERNEL_COMMIT_HASH - an explicit pin from the caller;
	#   2. the built tree's own git HEAD - the only source that describes
	#      what is actually being compiled (a local checkout, or a build
	#      started from one). Note a newer upstream commit must NOT win here:
	#      it would print a hash the tree does not contain;
	#   3. github, with retries - CI builds from a tarball with no .git, and
	#      a single-shot git ls-remote drops out often enough under load that
	#      the silent "unknown" fallback renames the release string, and with
	#      it every module path, behind the builder's back.
	COMMIT_HASH="$${KERNEL_COMMIT_HASH:-}"; \
		if [ -z "$$COMMIT_HASH" ] && [ -d .git ]; then \
			COMMIT_HASH=$$(git rev-parse --short=7 HEAD 2>/dev/null); \
		fi; \
		if [ -z "$$COMMIT_HASH" ]; then \
			for attempt in 1 2 3 4; do \
				COMMIT_HASH=$$(timeout 20 git ls-remote \
					https://github.com/iLtanaka/linux-marble.git \
					refs/heads/main 2>/dev/null | cut -c1-7); \
				[ -n "$$COMMIT_HASH" ] && break; \
				sleep 2; \
			done; \
		fi; \
		[ -n "$$COMMIT_HASH" ] || COMMIT_HASH=unknown; \
		LOCALVERSION_FULL="-$(SOC)-g$$COMMIT_HASH"; \
		echo "$$LOCALVERSION_FULL" > .lkv_suffix; \
	\
	export CCACHE_DIR="$${CCACHE_DIR:-$$HOME/.ccache}"; \
	export CCACHE_MAXSIZE="$${CCACHE_MAXSIZE:-10G}"; \
	export CCACHE_SLOPPINESS="file_macro,locale,time_macros"; \
	export CCACHE_NOHASHDIR="true"; \
	\
	cp $(KERNEL_CONFIG) .config; \
	\
	make ARCH=$(KERNEL_ARCH) CC="ccache clang" LLVM=1 \
		LOCALVERSION="$$LOCALVERSION_FULL" olddefconfig; \
	make ARCH=$(KERNEL_ARCH) CC="ccache clang" LLVM=1 \
		LOCALVERSION="$$LOCALVERSION_FULL" -j$$(nproc) \
		Image modules qcom/$(DTB_NAME).dtb

override_dh_auto_install:
	# /boot carries only what the boot chain reads: the uncompressed Image
	# (under the vmlinuz- name the postinst syncs to the ESP) and the DTB.
	# No Image- duplicate, no Image.gz (U-Boot booti loads uncompressed), no
	# System.map/config (debug/info only, never read at boot).
	# The exact .config the kernel was built with ships next to the
	# kernel.release marker instead of /boot.
	KREL=$$(cat include/config/kernel.release); \
	install -d \
		debian/$(PKG)/boot \
		debian/$(PKG)/usr/lib/modules/$$KREL/dtb/qcom \
		debian/$(PKG)/usr/share/$(PKG); \
	\
	make ARCH=$(KERNEL_ARCH) CC="ccache clang" LLVM=1 \
		INSTALL_MOD_PATH=debian/$(PKG) modules_install; \
	rm -rf debian/$(PKG)/usr/lib/modules/$$KREL/build; \
	rm -rf debian/$(PKG)/usr/lib/modules/$$KREL/source; \
	\
	install -Dm644 arch/$(KERNEL_ARCH)/boot/Image \
		debian/$(PKG)/boot/vmlinuz-$$KREL; \
	install -Dm644 arch/$(KERNEL_ARCH)/boot/dts/qcom/$(DTB_NAME).dtb \
		debian/$(PKG)/boot/$(DTB_NAME)-$$KREL.dtb; \
	install -Dm644 arch/$(KERNEL_ARCH)/boot/dts/qcom/$(DTB_NAME).dtb \
		debian/$(PKG)/usr/lib/modules/$$KREL/dtb/qcom/$(DTB_NAME).dtb; \
	\
	install -Dm644 include/config/kernel.release \
		debian/$(PKG)/usr/share/$(PKG)/kernel.release; \
	install -Dm644 .config \
		debian/$(PKG)/usr/share/$(PKG)/config-$$KREL

# Kernel binaries must never be stripped; modules keep their debug info
# (no INSTALL_MOD_STRIP), so skip dh_strip entirely.
override_dh_strip:

# Built on Fedora hosts without dpkg shlib metadata (see README).
override_dh_shlibdeps:
